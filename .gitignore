# ---- Secrets (never commit) ----
.env
.env.*
!.env.example

# ---- Dependencies ----
node_modules/

# ---- Build output ----
dist/
build/
.next/
out/
*.tsbuildinfo

# ---- Test / coverage ----
coverage/

# ---- Logs ----
*.log
npm-debug.log*
logs/

# ---- Evaluation run results (generated, can be large) ----
evaluation/results/

# ---- Uploaded files at runtime (sample docs in documents/ ARE committed) ----
uploads/

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Claude Code local settings (may contain personal paths/permissions) ----
.claude/settings.local.json
