# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored. NEVER commit real keys.
#
# Variables are added milestone by milestone. Each one notes when it starts being used.

# ---------- General ----------
NODE_ENV=development

# ---------- Backend API (Milestone 2) ----------
API_PORT=4000
LOG_LEVEL=info

# ---------- Frontend (Milestone 3) ----------
# The ONLY value the browser may see. Public URL of the backend, never a secret.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- PostgreSQL + pgvector (Milestone 4) ----------
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=knowledge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://assistant:change-me-locally@localhost:5432/knowledge

# ---------- Redis (Milestone 4) ----------
REDIS_URL=redis://localhost:6379

# ---------- LLM providers (Milestone 6+) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
