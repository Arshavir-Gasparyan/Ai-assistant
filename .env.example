# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored. NEVER commit real keys.
#
# Variables are added milestone by milestone. Each one notes when it starts being used.

# ---------- General ----------
NODE_ENV=development

# ---------- Backend API (Milestone 2) ----------
API_PORT=4000
LOG_LEVEL=info
# Browser origins allowed to call the API (comma-separated). See ADR-0002.
CORS_ORIGINS=http://localhost:3000

# ---------- Frontend (Milestone 3) ----------
# Next.js reads env files from frontend/, not from here. Configure it in frontend/.env.local
# (copy frontend/.env.example). The only frontend variable is NEXT_PUBLIC_API_URL.

# ---------- PostgreSQL + pgvector (Milestone 4) ----------
# Used by docker compose to create the database.
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=knowledge
# Host port. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433
# Used by the backend when it runs on your Mac (npm run dev / npm run migrate).
# Inside Docker, compose overrides it with host "postgres" and port 5432.
# If the password has special characters (@ : / #), URL-encode them here.
DATABASE_URL=postgresql://assistant:change-me-locally@localhost:5433/knowledge

# ---------- Redis (Milestone 4) ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------- LLM providers (Milestone 6+) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
