{
  "name": "ai-knowledge-assistant-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server (stdio) exposing the knowledge base as tools: search_documents, ask_question",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "knowledge-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
